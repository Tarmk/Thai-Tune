# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app (Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Flat.io embed/API key (score editor)
NEXT_PUBLIC_FLAT_KEY=

# OpenAI (AI assistant chat)
OPENAI_API_KEY=

# Resend (transactional email: verification, support replies)
RESEND_API_KEY=

# Optional SMTP fallback for support mail (see EMAIL_SETUP_GUIDE.md)
SUPPORT_EMAIL=
SUPPORT_EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
