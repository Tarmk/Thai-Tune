rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      // Anyone can read profiles (community/user pages)
      allow read: if true;

      // Allow the signed-in user to create their own profile doc at signup
      allow create: if signedIn() && request.auth.uid == userId;

      // Owner can update/delete their own profile
      allow delete: if signedIn() && request.auth.uid == userId;

      // Allow follow/unfollow by permitting *only* followers array changes
      // that add/remove the requesting user's uid.
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(["followers"]) &&
          (
            // follow: add your uid
            (
              request.resource.data.followers.size() == resource.data.followers.size() + 1 &&
              !(request.auth.uid in resource.data.followers) &&
              (request.auth.uid in request.resource.data.followers)
            ) ||
            // unfollow: remove your uid
            (
              request.resource.data.followers.size() == resource.data.followers.size() - 1 &&
              (request.auth.uid in resource.data.followers) &&
              !(request.auth.uid in request.resource.data.followers)
            )
          )
        )
      );
    }

    // 2FA settings (frontend reads this during login)
    match /userSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Scores
    match /scores/{scoreId} {
      // Public scores are readable by anyone; private/unlisted are only readable by the owner.
      // Check if sharing field exists, default to "private" if missing
      allow read: if ("sharing" in resource.data && resource.data.sharing == "public") ||
        (signedIn() && "userId" in resource.data && resource.data.userId == request.auth.uid);

      // Only owner can create/update/delete their scores
      allow create: if signedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && 
        "userId" in resource.data &&
        resource.data.userId == request.auth.uid;
    }

    // Bookmarks (per-user)
    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && 
        "userId" in resource.data &&
        resource.data.userId == request.auth.uid;
      allow create: if signedIn() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && 
        "userId" in resource.data &&
        resource.data.userId == request.auth.uid;
    }

    // Comments
    match /comments/{commentId} {
      // Anyone can read comments (they're filtered by scoreId in queries)
      allow read: if true;
      
      // Anyone signed in can create comments
      allow create: if signedIn();
      
      // Only the comment author can update/delete their own comments
      allow update, delete: if signedIn() && 
        "userId" in resource.data &&
        resource.data.userId == request.auth.uid;
    }

    // Reports
    match /scoreReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      // No client reads/writes beyond create
      allow read, update, delete: if false;
    }
  }
}
